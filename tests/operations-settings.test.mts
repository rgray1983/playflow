import assert from "node:assert/strict";
import {test} from "node:test";
import {tenantForms,moduleEnabled,validateFormContent} from "../src/lib/operations/settings";
import {legalForm,type LegalForm} from "../src/lib/waivers/forms";
import {validateSigning,saveSignedForm} from "../src/lib/waivers/signing";
import {hasPermission} from "../src/lib/auth/permissions";
const own:LegalForm={...legalForm("LIABILITY"),version:"business-b-v1",title:"Business B Waiver",clauses:[["only","Business B terms","Business B approved wording."]],photoConsentText:null};
const signature={version:own.version,signerName:"Test Parent",signerEmail:"test@example.invalid",signature:"Test Parent",signatureConsent:true,requestId:"business-signature-12345",acknowledgments:["only"]};
test("business forms never fall back to another venue's legal wording",()=>{assert.equal(tenantForms({slug:"new-business"}),null);assert.equal(tenantForms({slug:"palmetto-playhouse"})?.liability?.version,legalForm("LIABILITY").version);const forms=tenantForms({slug:"business-b",operationalSettings:{forms:{LIABILITY:own}}});assert.equal(forms?.liability?.title,own.title);assert.equal(forms?.rental,null);});
test("published form versions and required sections are validated against the current business",()=>{assert.equal(validateSigning(signature,"LIABILITY",own).version,own.version);assert.throws(()=>validateSigning({...signature,version:legalForm("LIABILITY").version},"LIABILITY",own));assert.throws(()=>validateSigning({...signature,acknowledgments:[]},"LIABILITY",own));});
test("a signed business document retains its full wording and one separate coverage per child",async()=>{let saved:any;const tx:any={waiver:{create:async({data}:any)=>{saved=data;return data;}}};const children=["one","two"].map(id=>({id,firstName:id,lastName:"Child",dateOfBirth:null}));await saveSignedForm(tx,{tenantId:"business-b",familyId:"family",parentId:"parent",kind:"LIABILITY",form:own,signing:validateSigning(signature,"LIABILITY",own),validityDays:null,children});assert.equal(saved.version,own.version);assert.equal(saved.children.create.length,2);assert.equal(JSON.parse(saved.waiverText).clauses[0][2],own.clauses[0][2]);assert.equal(saved.expiresAt,null);await assert.rejects(saveSignedForm(tx,{tenantId:"business-b",familyId:"family",parentId:"parent",kind:"LIABILITY",form:{...own,version:"updated"},signing:validateSigning(signature,"LIABILITY",own),validityDays:null,children}));});
test("invalid and duplicate form sections cannot be published",()=>{assert.equal(validateFormContent(own,"LIABILITY").clauses.length,1);for(const clauses of [[],[["a","Title","Text"],["a","Other","Text"]],[["bad id","Title","Text"]],[["a","", "Text"]]])assert.throws(()=>validateFormContent({...own,clauses},"LIABILITY"));});
test("module preferences default to available and only explicit false stops new activity",()=>{assert.equal(moduleEnabled(null,"parties"),true);assert.equal(moduleEnabled({modules:{parties:false}},"parties"),false);assert.equal(moduleEnabled({modules:{parties:false}},"admissions"),true);});
test("refunds require owner or manager permission even though front desk can collect payments",()=>{assert.equal(hasPermission("OWNER","payments.refund"),true);assert.equal(hasPermission("MANAGER","payments.refund"),true);for(const role of ["FRONT_DESK","PARTY_HOST","unknown"])assert.equal(hasPermission(role,"payments.refund"),false);assert.equal(hasPermission("FRONT_DESK","payments.write"),true);});
