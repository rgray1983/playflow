import assert from "node:assert/strict";
import {beforeEach,mock,test} from "node:test";
let states:any={},starts:any[]=[],pending=true,failed=false;
const db:any={bookingMessage:{fields:{scheduledAt:"scheduled-field"},findFirst:async(q:any)=>{assert.equal(q.where.tenantId,"tenant");return pending?{id:"message"}:null;}},$queryRaw:async()=>[],communicationJobState:{findUnique:async({where}:any)=>states[where.id]??null,upsert:async({where,create,update}:any)=>{states[where.id]=states[where.id]?{...states[where.id],...update}:create;},updateMany:async({where,data}:any)=>{const s=states[where.id];if(s&&s.startedAt.getTime()===where.startedAt.getTime())Object.assign(s,data);}}};db.$transaction=async(cb:any)=>cb(db);
mock.module("../src/lib/prisma.ts",{namedExports:{prisma:db}});
mock.module("workflow/api",{namedExports:{start:async(fn:any,args:any)=>{starts.push({fn:fn.name,args});if(failed)throw new Error("private queue error");return {runId:"run"};}}});
mock.module("../src/lib/communications/email-workflows.ts",{namedExports:{dispatchBookingEmails:async function dispatchBookingEmails(){},checkEmailTimer:async function checkEmailTimer(){}}});
const {startEmailAutomation,startAutomationCheck}=await import("../src/lib/communications/automation");
beforeEach(()=>{states={};starts=[];pending=true;failed=false;process.env.PLAYFLOW_EMAIL_AUTOMATION_MODE="workflow";});
test("automatic scheduling is opt-in and does not start empty dispatchers for routine staff activity",async()=>{delete process.env.PLAYFLOW_EMAIL_AUTOMATION_MODE;await startEmailAutomation("tenant");assert.equal(starts.length,0);process.env.PLAYFLOW_EMAIL_AUTOMATION_MODE="workflow";pending=false;await startEmailAutomation("tenant");assert.equal(starts.length,0);pending=true;await startEmailAutomation("tenant");assert.deepEqual(starts[0].args,["tenant"]);});
test("the explicit timer check uses a tenant-specific checkpoint and rate limit",async()=>{await startAutomationCheck("tenant");assert.equal(starts[0].fn,"checkEmailTimer");assert.equal(starts[0].args[0],"tenant");assert.ok(states["booking-email-check:tenant"].startedAt);await assert.rejects(startAutomationCheck("tenant"),/Wait two minutes/);assert.equal(starts.length,1);});
test("queue-start failures expose a safe recoverable result and persist health failure timestamps",async()=>{failed=true;await assert.rejects(startAutomationCheck("tenant"),/could not start/);assert.ok(states["booking-email-check:tenant"].failedAt);await assert.rejects(startEmailAutomation("tenant"),/could not start/);assert.ok(states["booking-email"].failedAt);});
