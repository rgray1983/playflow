import assert from 'node:assert/strict';
import {beforeEach,test} from 'node:test';
import {randomUUID} from 'node:crypto';
import {changeMembership,renewalSource} from '../src/lib/memberships/management';
import {membershipBalance} from '../src/lib/memberships/balance';
import {membershipUse} from '../src/lib/visits/service';
import {membershipQuote,enrollMembership,recordCounterPayment} from '../src/lib/counter/service';
import {defaultCommerceSettings} from '../src/lib/commerce-settings';
import {hasPermission} from '../src/lib/auth/permissions';
let members:any[],changes:any[],visits:any[],sales:any[],payments:any[],plan:any,family:any,failAudit:boolean,pending:boolean,settings:any;
const staff={tenantId:'tenant',employeeId:'manager',name:'Test Manager',accessRole:'MANAGER'};
const matching=(v:any,w:any)=>Object.entries(w).every(([k,val]:any)=>val&&typeof val==='object'&&!(val instanceof Date)?val.in?val.in.includes(v[k]):val.not?v[k]!==val.not:true:v[k]===val);
const tx:any={
 $queryRaw:async(q:any)=>q.text.includes('ProviderCheckout')&&pending?[{id:'pending'}]:[],
 tenant:{findUniqueOrThrow:async()=>({id:'tenant',timezone:'America/New_York',operationalSettings:{},name:'Venue'})},commerceSettings:{findUnique:async()=>settings},
 family:{findFirst:async({where}:any)=>matching(family,where)?family:null},child:{findFirst:async({where}:any)=>where.id==='child'&&where.familyId==='family'&&where.tenantId==='tenant'?{id:'child'}:null},
 membershipPlan:{findFirst:async({where}:any)=>matching(plan,where)?plan:null},
 membership:{findFirst:async({where}:any)=>{const m=members.find(m=>matching(m,where));return m?{...m,family:{...family},membershipPlan:plan,counterSale:sales.find(s=>s.membershipId===m.id)??null}:null;},create:async({data}:any)=>{const m={id:`membership-${members.length}`,updatedAt:new Date(),visitCreditAdjustment:0,renewedFromId:null,...data};members.push(m);return m;},update:async({where,data}:any)=>{const m=members.find(m=>matching(m,where));for(const [key,value] of Object.entries(data) as any){m[key]=value&&typeof value==='object'&&'increment'in value?(m[key]??0)+value.increment:value;}m.updatedAt=new Date(m.updatedAt.getTime()+1000);return m;}},
 membershipChange:{findUnique:async({where}:any)=>changes.find(c=>matching(c,where.tenantId_requestId)),create:async({data}:any)=>{if(failAudit)throw Error('audit failure');changes.push(data);return data;}},
 visit:{count:async({where}:any)=>visits.filter(v=>v.tenantId===where.tenantId&&v.familyId===where.familyId&&v.membershipId===where.membershipId&&v.status!=='CANCELLED'&&v.checkedInAt>=where.checkedInAt.gte).length,findFirst:async({where}:any)=>visits.find(v=>matching(v,where))??null},
 counterSale:{findFirst:async({where}:any)=>{const s=sales.find(s=>matching(s,where));return s?{...s,payments:payments.filter(p=>p.saleId===s.id),membership:members.find(m=>m.id===s.membershipId)}:null;},create:async({data}:any)=>{const s={id:`sale-${sales.length}`,createdAt:new Date(),...data};sales.push(s);return s;},update:async({where,data}:any)=>Object.assign(sales.find(s=>matching(s,where)),data)},
 counterPayment:{findFirst:async({where}:any)=>payments.find(p=>matching(p,where))??null,create:async({data}:any)=>{const p={id:`pay-${payments.length}`,...data};payments.push(p);return p;}},
};
let queue=Promise.resolve();const transaction=async(callback:any)=>{let release!:()=>void;const old=queue;queue=new Promise<void>(r=>{release=r;});await old;const saved=structuredClone({members,changes,sales,payments});try{return await callback(tx);}catch(e){({members,changes,sales,payments}=saved);throw e;}finally{release();}};
const body=(action='adjust',extra:any={})=>({action,requestId:randomUUID(),updatedAt:members[0].updatedAt.toISOString(),reason:'Approved correction',...(action==='adjust'?{delta:1}:{confirmEnd:true}),...extra});
const save=(b:any,actor=staff,id='original',familyId='family')=>transaction((db:any)=>changeMembership(db,actor,familyId,id,b));
const rejected=(p:Promise<unknown>,status:number)=>assert.rejects(p,(e:any)=>e.status===status);
const source=()=>({...members[0],membershipPlan:plan});
const visit=(i:number,status='CHECKED_OUT')=>({id:`visit-${i}`,tenantId:'tenant',familyId:'family',membershipId:'original',status,checkedInAt:new Date(),checkedOutAt:status==='CHECKED_IN'?null:new Date()});
beforeEach(()=>{family={id:'family',tenantId:'tenant',status:'ACTIVE'};plan={id:'plan',tenantId:'tenant',active:true,name:'Five visits',price:20,visitLimit:5,durationDays:30,billingInterval:'NONE',updatedAt:new Date('2026-01-01')};members=[{id:'original',tenantId:'tenant',familyId:'family',childId:null,name:'Five visits',status:'ACTIVE',membershipPlanId:'plan',startsAt:new Date('2026-01-01'),endsAt:null,updatedAt:new Date('2026-01-01'),autoRenew:false,stripeSubscriptionId:null,visitCreditAdjustment:0,termsSnapshot:{version:1,visitLimit:5}}];changes=[];visits=[visit(1),visit(2)];sales=[];payments=[];pending=false;failAudit=false;settings=structuredClone(defaultCommerceSettings);queue=Promise.resolve();});
test('desk staff can read memberships, while only managers can correct or end rights',async()=>{assert.ok(hasPermission('FRONT_DESK','memberships.read'));assert.equal(hasPermission('FRONT_DESK','memberships.manage'),false);assert.equal(hasPermission('PARTY_HOST','memberships.read'),false);await rejected(save(body(),{...staff,accessRole:'FRONT_DESK'}),403);assert.equal(changes.length,0);});
test('credit corrections preserve purchased terms and real visits, and immediately update check-in eligibility',async()=>{const original=structuredClone(members[0].termsSnapshot);await save(body('adjust',{delta:-3}));assert.deepEqual(members[0].termsSnapshot,original);assert.equal(visits.length,2);let use=await membershipUse(tx,source(),'tenant','family','child');assert.equal(use.remaining,0);assert.equal(use.eligible,false);await save(body('adjust',{delta:2}));use=await membershipUse(tx,source(),'tenant','family','child');assert.equal(use.remaining,2);assert.equal(use.eligible,true);assert.deepEqual(changes.map(c=>c.creditDelta),[-3,2]);});
test('corrections cannot remove consumed visits, change unlimited packs, or use invalid values',async()=>{for(const delta of [-4,0,1.5,1001])await rejected(save(body('adjust',{delta})),delta===-4?409:400);members[0].termsSnapshot.visitLimit=null;await rejected(save(body()),409);assert.equal(changes.length,0);});
test('scope, protected fields, inactive families, expired rights and pending Square attempts are enforced',async()=>{await rejected(save(body(),{...staff,tenantId:'foreign'}),404);await rejected(save(body(),staff,'foreign'),404);await rejected(save(body('adjust',{termsSnapshot:{version:1,visitLimit:100}})),400);family.status='ARCHIVED';await rejected(save(body()),409);family.status='ACTIVE';members[0].endsAt=new Date('2020-01-01');await rejected(save(body()),409);members[0].endsAt=null;sales.push({id:'sale',membershipId:'original',status:'PAID'});pending=true;await rejected(save(body()),409);assert.equal(changes.length,0);});
test('ending a membership preserves payment and visit history and refuses active visits or external billing',async()=>{visits.push(visit(3,'CHECKED_IN'));await rejected(save(body('end')),409);visits.pop();members[0].stripeSubscriptionId='external';await rejected(save(body('end')),409);members[0].stripeSubscriptionId=null;await rejected(save(body('end',{confirmEnd:false})),400);await save(body('end'));assert.equal(members[0].status,'CANCELLED');assert.ok(members[0].cancelledAt instanceof Date);assert.equal(visits.length,2);assert.equal((await membershipUse(tx,source(),'tenant','family','child')).eligible,false);assert.equal(changes[0].staffName,'Test Manager');});
test('pending enrollment must be resolved by its bill instead of bypassing payment',async()=>{members[0].status='PENDING';await rejected(save(body('end')),409);await rejected(save(body()),409);assert.equal(members[0].status,'PENDING');});
test('identical retries commit once; changed requests and stale concurrent corrections fail',async()=>{const b=body();const results=await Promise.all([save(b),save(b)]);assert.equal(results.filter(r=>r.replayed).length,1);assert.equal(changes.length,1);assert.equal(members[0].visitCreditAdjustment,1);await rejected(save({...b,delta:2}),409);await rejected(save({...b,requestId:randomUUID()}),409);});
test('audit failure rolls the correction back in the same transaction',async()=>{failAudit=true;await assert.rejects(save(body()),/audit failure/);assert.equal(members[0].visitCreditAdjustment,0);assert.equal(changes.length,0);});
test('renewal preserves old term and coverage, creates an unpaid new bill, and activates only after full payment',async()=>{
 visits=Array.from({length:5},(_,i)=>visit(i));const old=structuredClone(members[0]);const input={familyId:'family',planId:'plan',childId:null,renewalOfId:'original',sourceUpdatedAt:members[0].updatedAt.toISOString(),requestId:randomUUID()};const q=await membershipQuote(tx,staff,input);const result=await transaction((db:any)=>enrollMembership(db,staff,{...input,quoteHash:q.quoteHash}));
 assert.deepEqual(members[0],old);assert.equal(members[1].renewedFromId,'original');assert.equal(members[1].status,'PENDING');assert.equal(sales[0].status,'OPEN');assert.equal(changes[0].relatedMembershipId,members[1].id);
 const replay=await transaction((db:any)=>enrollMembership(db,staff,{...input,quoteHash:q.quoteHash}));assert.equal(replay.replayed,true);assert.equal(members.length,2);
 await transaction((db:any)=>recordCounterPayment(db,staff,{saleId:result.saleId,requestId:randomUUID(),amountCents:sales[0].totalCents,method:'cash',collectedAcknowledged:true}));assert.equal(members[1].status,'ACTIVE');assert.equal(members[0].status,old.status);assert.equal(visits.length,5);
 await rejected(renewalSource(tx,'tenant','family','original',members[0].updatedAt.toISOString()),409);
});
test('renewals reject unspent rights, wrong coverage, changed source versions and active visits',async()=>{const input={familyId:'family',planId:'plan',childId:null,renewalOfId:'original',sourceUpdatedAt:members[0].updatedAt.toISOString()};await rejected(membershipQuote(tx,staff,input),409);members[0].endsAt=new Date('2020-01-01');await rejected(membershipQuote(tx,staff,{...input,sourceUpdatedAt:'stale'}),409);await rejected(membershipQuote(tx,staff,{...input,childId:'child'}),400);visits.push(visit(4,'CHECKED_IN'));await rejected(membershipQuote(tx,staff,input),409);assert.equal(members.length,1);});
test('balances count only this term and business, exclude cancelled visits, and retain shared child-use accounting',async()=>{visits.push({...visit(3),tenantId:'foreign'},visit(4,'CANCELLED'),{...visit(5),membershipId:'different'});const b=await membershipBalance(tx,source());assert.equal(b.used,2);assert.equal(b.remaining,3);assert.equal((await membershipUse(tx,source(),'foreign','family','child')).eligible,false);});

test('concurrent different renewal requests create one successor and audit failure rolls its bill back',async()=>{visits=Array.from({length:5},(_,i)=>visit(i));const input={familyId:'family',planId:'plan',childId:null,renewalOfId:'original',sourceUpdatedAt:members[0].updatedAt.toISOString()};const q=await membershipQuote(tx,staff,input);const buy=()=>transaction((db:any)=>enrollMembership(db,staff,{...input,requestId:randomUUID(),quoteHash:q.quoteHash}));failAudit=true;await assert.rejects(buy(),/audit failure/);assert.equal(members.length,1);assert.equal(sales.length,0);failAudit=false;const outcomes=await Promise.allSettled([buy(),buy()]);assert.equal(outcomes.filter(r=>r.status==='fulfilled').length,1);assert.equal(members.length,2);assert.equal(sales.length,1);assert.equal(changes.length,1);});
test('free renewals activate once without creating a payment or changing the old usage',async()=>{members[0].endsAt=new Date('2020-01-01');plan.price=0;const input={familyId:'family',planId:'plan',childId:null,renewalOfId:'original',sourceUpdatedAt:members[0].updatedAt.toISOString(),requestId:randomUUID()};const q=await membershipQuote(tx,staff,input);await transaction((db:any)=>enrollMembership(db,staff,{...input,quoteHash:q.quoteHash}));assert.equal(members[1].status,'ACTIVE');assert.equal(sales[0].status,'PAID');assert.equal(payments.length,0);assert.equal(visits.length,2);});
test('membership views remain scoped and readable for archived families without exposing external billing IDs',async()=>{
 const {familyMemberships}=await import('../src/lib/memberships/queries');const calls:any[]=[];
 const mockDb:any={family:{findFirst:async({where}:any)=>where.tenantId==='tenant'&&where.id==='family'?{id:'family',status:'ARCHIVED'}:null},tenant:tx.tenant,membershipPlan:{findMany:async()=>[]},visit:{count:async()=>2,findMany:async(q:any)=>{calls.push(q);return[];}},membershipChange:{findMany:async(q:any)=>{calls.push(q);return[];}},membership:{findMany:async(q:any)=>{calls.push(q);if(q.select)return[];return[{...members[0],stripeSubscriptionId:'secret-provider-reference',membershipPlan:plan,child:null,counterSale:null}];}}};
 const result=await familyMemberships(mockDb,staff,'family',new URLSearchParams('memberId=original'));assert.equal(result.familyStatus,'ARCHIVED');assert.equal(result.canSell,false);assert.equal(result.items[0].canRenew,false);assert.equal(JSON.stringify(result).includes('secret-provider-reference'),false);for(const q of calls){assert.equal(q.where.tenantId,'tenant');assert.equal(q.where.familyId,'family');}assert.equal(calls[0].take,21);await rejected(familyMemberships(mockDb,staff,'foreign',new URLSearchParams()),404);await rejected(familyMemberships(mockDb,staff,'family',new URLSearchParams('page=-1')),400);await rejected(familyMemberships(mockDb,{...staff,accessRole:'PARTY_HOST'},'family',new URLSearchParams()),403);
});
