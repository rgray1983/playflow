import assert from "node:assert/strict";
import {test,mock} from "node:test";
mock.module("../src/lib/prisma.ts",{namedExports:{prisma:{}}});
const {reportRange,collections}=await import("../src/lib/reports/daily");
const {readerLaunch,verifyPayment}=await import("../src/lib/payments/square/checkout");
test("daily report boundaries follow the business timezone through daylight-saving changes",()=>{assert.equal(reportRange("2026-03-08","America/New_York").lt.getTime()-reportRange("2026-03-08","America/New_York").gte.getTime(),23*3600000);assert.equal(reportRange("2026-11-01","America/New_York").lt.getTime()-reportRange("2026-11-01","America/New_York").gte.getTime(),25*3600000);assert.throws(()=>reportRange("2026-02-30","America/New_York"));});
test("collections count deposits once in the event ledger and subtract refunds independently",()=>{assert.deepEqual(collections(1500,10000,2500),{counterCents:1500,partyCents:10000,grossCents:11500,refundCents:2500,netCents:9000});});
const intent:any={id:"intent",channel:"READER",readerState:"server-random-state",status:"PENDING",amountCents:1500};
test("iPad reader launch binds amount, callback, location, state and server marker and permits cards only",()=>{const launch=readerLaunch(intent,"app","https://playflow.example","location");assert.ok(launch.startsWith("square-commerce-v1://payment/create?data="));const data=JSON.parse(decodeURIComponent(launch.split("?data=")[1]));assert.equal(data.amount_money.amount,1500);assert.equal(data.callback_url,"https://playflow.example/payments/reader-return");assert.equal(data.location_id,"location");assert.deepEqual(data.options.supported_tender_types,["CREDIT_CARD"]);assert.equal(data.options.clear_default_fees,true);assert.equal(data.notes,"PlayFlow checkout intent server-random-state");assert.throws(()=>readerLaunch({...intent,status:"PAID"},"a","https://example.com","l"));});
test("reader callbacks cannot substitute an old payment, cash tender, different location or changed amount",()=>{const payment:any={id:"payment",status:"COMPLETED",source_type:"CARD",note:"PlayFlow checkout intent server-random-state",location_id:"location",amount_money:{amount:1500,currency:"USD"}};assert.equal(verifyPayment(payment,intent,"location"),true);for(const change of [{note:"old payment"},{source_type:"CASH"},{location_id:"other"},{amount_money:{amount:1499,currency:"USD"}},{amount_money:{amount:1500,currency:"CAD"}},{refunded_money:{amount:1}}])assert.throws(()=>verifyPayment({...payment,...change},intent,"location"));assert.equal(verifyPayment({...payment,status:"APPROVED"},intent,"location"),false);});
