import assert from 'node:assert/strict';
import {beforeEach,mock,test} from 'node:test';
import {defaultEmailCopy} from '../src/lib/communications/copy';
let signedIn=true,role='OWNER',writes=0,dispatches=0,lastWhere:any;
let tenant:any,tail=Promise.resolve();
const db:any={employee:{findUnique:async()=>role==='PARENT'?null:{id:'staff',tenantId:'tenant-a',authUserId:'user',firstName:'Test',lastName:'Owner',status:'ACTIVE',accessApproved:true,accessRole:role,staffRole:null},findMany:async()=>[]},tenant:{
 findUniqueOrThrow:async(q:any)=>{lastWhere=q.where;assert.equal(q.where.id,'tenant-a');return q.select?Object.fromEntries(Object.keys(q.select).map(key=>[key,tenant[key]])):structuredClone(tenant);},
 update:async(q:any)=>{assert.equal(q.where.id,'tenant-a');writes++;tenant={...tenant,...structuredClone(q.data)};return tenant;},
},$queryRaw:async()=>[]};
db.$transaction=async(callback:any)=>{const previous=tail;let done!:()=>void;tail=new Promise<void>(resolve=>{done=resolve;});await previous;try{return await callback(db);}finally{done();}};
mock.module('../src/lib/prisma.ts',{namedExports:{prisma:db}});
mock.module('../src/lib/auth/server.ts',{namedExports:{getAuth:()=>({getSession:async()=>({data:signedIn?{user:{id:'user',email:'owner@example.invalid',emailVerified:true}}:null,error:null})})}});
mock.module('../src/lib/communications/background.ts',{namedExports:{scheduleDelivery:()=>{dispatches++;}}});
const {GET,PUT}=await import('../src/app/api/communications/templates/route');
const {PUT:putOperations}=await import('../src/app/api/operations/route');
beforeEach(()=>{signedIn=true;role='OWNER';writes=0;dispatches=0;tail=Promise.resolve();tenant={id:'tenant-a',name:'Our Venue',timezone:'America/New_York',operationalSettings:{forms:{saved:'legal'},modules:{retail:false},communications:{enabled:true,reminderHours:72,templates:{REMINDER:{subject:'Saved reminder',introduction:'Remember socks.',closing:'See you soon.'}}}}};});
const request=(body:any,origin='https://app.example.invalid')=>new Request('https://app.example.invalid/api/communications/templates',{method:'PUT',headers:{'Content-Type':'application/json',origin},body:JSON.stringify(body)});
async function settings(){return (await GET()).json();}
async function save(extra:any={}){const loaded=await settings();return PUT(request({kind:'HOLD',revision:loaded.revision,template:{subject:'Your celebration',introduction:'Hello from our team.\nWe are ready to help.',closing:'Thank you!'},...extra}));}
test('editor reads business-specific wording, defaults and revision without dispatching emails',async()=>{const result=await settings();assert.equal(result.brand.name,'Our Venue');assert.equal(result.templates.HOLD.subject,defaultEmailCopy('HOLD').subject);assert.equal(result.templates.REMINDER.subject,'Saved reminder');assert.match(result.revision,/^[a-f0-9]{64}$/);assert.equal(dispatches,0);});
test('saving one kind preserves other email types, legal forms, modules and delivery rules',async()=>{const before=await settings(),response=await save({tenantId:'foreign-tenant'});assert.equal(response.status,200);const result=await response.json();assert.notEqual(result.revision,before.revision);assert.equal(result.templates.HOLD.subject,'Your celebration');assert.equal(result.templates.REMINDER.subject,'Saved reminder');assert.deepEqual(tenant.operationalSettings.forms,{saved:'legal'});assert.deepEqual(tenant.operationalSettings.modules,{retail:false});assert.equal(tenant.operationalSettings.communications.enabled,true);assert.equal(tenant.operationalSettings.communications.reminderHours,72);assert.equal(writes,1);assert.equal(dispatches,0);assert.equal(lastWhere.id,'tenant-a');});
test('subject headers, oversized content and attempts to edit controlled details are rejected',async()=>{
 for(const template of [{subject:'Hello\r\nBcc: other@example.invalid',introduction:'Hi',closing:''},{subject:'x'.repeat(161),introduction:'Hi',closing:''},{subject:'Hello',introduction:'x'.repeat(1201),closing:''},{subject:'Hello',introduction:'Hi',closing:'x'.repeat(801)},{subject:'Hello',introduction:'Hi',closing:'',hostUrl:'https://wrong.invalid'},{subject:'',introduction:'Hi',closing:''},{subject:'Hello',introduction:'\u0000bad',closing:''}])assert.equal((await save({template})).status,400);
 assert.equal(writes,0);assert.equal(dispatches,0);
});
test('concurrent edits require the original revision and never overwrite another session',async()=>{const loaded=await settings();const responses=await Promise.all(['HOLD','CONFIRMATION'].map(kind=>PUT(request({kind,revision:loaded.revision,template:{subject:'Custom '+kind,introduction:'Hello',closing:''}}))));assert.deepEqual(responses.map(r=>r.status),[200,409]);assert.equal(writes,1);assert.equal(tenant.operationalSettings.communications.templates.CONFIRMATION,undefined);assert.equal(dispatches,0);});
test('resetting defaults and an optional empty closing work without enabling delivery',async()=>{tenant.operationalSettings.communications.enabled=false;assert.equal((await save({template:defaultEmailCopy('HOLD')})).status,200);assert.equal((await save({template:{subject:'Hello',introduction:'Welcome!',closing:''}})).status,200);assert.equal(tenant.operationalSettings.communications.templates.HOLD.closing,'');assert.equal(tenant.operationalSettings.communications.enabled,false);assert.equal(dispatches,0);});
test('saving reminder rules preserves customized email wording',async()=>{const before=structuredClone(tenant.operationalSettings.communications.templates);const response=await putOperations(request({section:'communications',enabled:false,reminderHours:24}));assert.equal(response.status,200);assert.deepEqual(tenant.operationalSettings.communications.templates,before);assert.equal(tenant.operationalSettings.communications.reminderHours,24);assert.equal(dispatches,1);});
test('editor requires approved settings staff and rejects cross-site writes',async()=>{signedIn=false;assert.equal((await GET()).status,401);signedIn=true;for(const value of ['PARENT','PARTY_HOST','FRONT_DESK']){role=value;assert.equal((await GET()).status,403);assert.equal((await PUT(request({}))).status,403);}role='MANAGER';assert.equal((await GET()).status,200);assert.equal((await PUT(request({},'https://foreign.invalid'))).status,403);assert.equal(writes,0);assert.equal(dispatches,0);});
