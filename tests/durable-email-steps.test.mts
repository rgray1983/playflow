import assert from "node:assert/strict";
import {beforeEach,mock,test} from "node:test";
let m:any,queries:any[]=[],sends=0,ready=true,afterSend="SENT",states:any={},tail=Promise.resolve();
const claim={id:"message",tenantId:"tenant",key:"worker-a"};
const db:any={bookingMessage:{
 findFirst:async({where}:any)=>m&&Object.entries(where).every(([k,v])=>m[k]===v)?structuredClone(m):null,
 update:async({where,data}:any)=>{assert.equal(where.id,m.id);Object.assign(m,data);return m;},
 updateMany:async({where,data}:any)=>{if(!m||Object.entries(where).some(([k,v]:any)=>k==="status"?!v.in.includes(m.status):m[k]!==v))return {count:0};Object.assign(m,data);return {count:1};},
},communicationJobState:{upsert:async({where,create,update}:any)=>{states[where.id]=states[where.id]?{...states[where.id],...update}:create;},update:async({where,data}:any)=>Object.assign(states[where.id],data),updateMany:async({where,data}:any)=>{const s=states[where.id];if(!s||s.startedAt.getTime()!==where.startedAt.getTime())return {count:0};Object.assign(s,data);return {count:1};}},$queryRaw:async(q:any)=>{queries.push(q);return m&&!m.automationKey?[{id:m.id,tenantId:m.tenantId,scheduledAt:m.scheduledAt}]:[];}};
db.$transaction=async(callback:any)=>{const previous=tail;let done!:()=>void;tail=new Promise<void>(resolve=>{done=resolve;});await previous;try{return await callback(db);}finally{done();}};
mock.module("../src/lib/prisma.ts",{namedExports:{prisma:db}});
mock.module("../src/lib/communications/service.ts",{namedExports:{senderReady:()=>ready,deliverMessage:async(id:string,tenantId:string)=>{assert.equal(id,m.id);assert.equal(tenantId,m.tenantId);sends++;m.status=afterSend;if(afterSend==="QUEUED")m.retryAt=new Date(Date.now()+120000);}}});
const {claimEmailBatch,rememberEmailRun,runEmailAttempt,failEmailAutomation,completeAutomationCheck}=await import("../src/lib/communications/automation-steps");
beforeEach(()=>{queries=[];sends=0;ready=true;afterSend="SENT";states={};tail=Promise.resolve();process.env.PLAYFLOW_EMAIL_AUTOMATION_MODE="workflow";process.env.PLAYFLOW_EMAIL_DELIVERY_MODE="live";process.env.VERCEL_ENV="production";delete process.env.PLAYFLOW_EMAIL_TEST_RECIPIENT_MODE;delete process.env.PLAYFLOW_EMAIL_TEST_RECIPIENTS;const startTime=new Date(Date.now()+5*86400000);m={id:"message",tenantId:"tenant",automationKey:"worker-a",automationAt:new Date(),automationError:null,automationRunId:"run-a",status:"QUEUED",kind:"REMINDER",recipient:"parent@example.invalid",scheduledAt:new Date(Date.now()+3600000),retryAt:null,updatedAt:new Date(),dedupeKey:`party:REMINDER:${startTime.toISOString()}:parent@example.invalid`,party:{status:"CONFIRMED",startTime,primaryParent:{email:"parent@example.invalid"}},tenant:{operationalSettings:{communications:{enabled:true}}}};});
test("a future reminder suspends until its due time and sends only when it wakes",async()=>{assert.equal(await runEmailAttempt(claim),m.scheduledAt.getTime());assert.equal(sends,0);m.scheduledAt=new Date(Date.now()-1000);assert.equal(await runEmailAttempt(claim),null);assert.equal(sends,1);assert.equal(m.automationKey,null);assert.ok(states["booking-email"].completedAt);});
test("obsolete workers and foreign tenant IDs have no authority over a message",async()=>{assert.equal(await runEmailAttempt({...claim,key:"old-worker"}),null);assert.equal(await runEmailAttempt({...claim,tenantId:"other"}),null);await failEmailAutomation({...claim,key:"old-worker"},"WORKER_FAILED");assert.equal(m.automationError,null);assert.equal(sends,0);});
test("cancelled, rescheduled and changed-recipient bookings retire future reminders without sending",async()=>{for(const change of [()=>{m.party.status="CANCELLED";},()=>{m.party.startTime=new Date(m.party.startTime.getTime()+3600000);},()=>{m.party.primaryParent.email="changed@example.invalid";}]){m.automationKey=claim.key;m.status="QUEUED";change();assert.equal(await runEmailAttempt(claim),null);assert.equal(m.status,"CANCELLED");assert.equal(m.failureCode,"BOOKING_CHANGED");}assert.equal(sends,0);});
test("provider backoff and fresh sending leases are respected by durable wakeups",async()=>{m.scheduledAt=new Date(0);m.retryAt=new Date(Date.now()+180000);assert.equal(await runEmailAttempt(claim),m.retryAt.getTime());m.retryAt=null;m.status="SENDING";assert.equal(await runEmailAttempt(claim),m.updatedAt.getTime()+61000);assert.equal(sends,0);m.status="QUEUED";m.scheduledAt=new Date(0);afterSend="QUEUED";assert.ok((await runEmailAttempt(claim))!>Date.now()+110000);assert.equal(sends,1);});
test("disabled configuration and removed recipient eligibility stop jobs without consuming delivery attempts",async()=>{for(const change of [()=>{ready=false;},()=>{m.tenant.operationalSettings.communications.enabled=false;},()=>{process.env.VERCEL_ENV="preview";}]){ready=true;m.tenant.operationalSettings.communications.enabled=true;m.automationKey=claim.key;change();assert.equal(await runEmailAttempt(claim),null);assert.equal(m.automationError,"WAITING_SETUP");}assert.equal(sends,0);});
test("message claims are bounded, row-locked and concurrent dispatchers cannot both claim the same row",async()=>{m.automationKey=null;const results=await Promise.all([claimEmailBatch("tenant"),claimEmailBatch("tenant")]);assert.equal(results[0].length,1);assert.equal(results[1].length,0);const first=results[0][0];assert.notEqual(first.key,"worker-a");assert.ok(queries[0].values.includes("tenant"));assert.match(queries[0].text,/LIMIT 10 FOR UPDATE OF m SKIP LOCKED/);await rememberEmailRun(first,"new-run");assert.equal(m.automationRunId,"new-run");await rememberEmailRun({...first,key:"stale"},"stale-run");assert.equal(m.automationRunId,"new-run");});
test("a failed worker records a recoverable scheduling issue without altering delivery payload or attempts",async()=>{const before=structuredClone(m);await failEmailAutomation(claim,"WORKER_FAILED");assert.equal(m.automationKey,null);assert.equal(m.automationError,"WORKER_FAILED");assert.equal(m.recipient,before.recipient);assert.equal(m.dedupeKey,before.dedupeKey);assert.equal(m.status,before.status);});
test("timer completion is tenant scoped and an older check cannot complete a newer one",async()=>{const startedAt=new Date();states["booking-email-check:tenant"]={startedAt};await completeAutomationCheck("other",startedAt.toISOString());assert.equal(states["booking-email-check:tenant"].completedAt,undefined);await completeAutomationCheck("tenant",new Date(0).toISOString());assert.equal(states["booking-email-check:tenant"].completedAt,undefined);await completeAutomationCheck("tenant",startedAt.toISOString());assert.ok(states["booking-email-check:tenant"].completedAt);assert.equal(sends,0);});
