import assert from "node:assert/strict";
import {beforeEach,mock,test} from "node:test";
let refunds:any[]=[],calls:any[]=[],providerStatus="COMPLETED",pendingStatus="PENDING";
const actor={tenantId:"a",employeeId:"staff",name:"Manager"};
const checkout:any={id:"checkout",tenantId:"a",connectionId:"connection",mode:"sandbox",status:"PAID",providerPaymentId:"provider-payment",amountCents:1500,channel:"CARD"};
const matches=(r:any,w:any)=>r.tenantId===w.tenantId&&(!w.id||r.id===w.id);
const db:any={
 $queryRaw:async()=>[],
 providerCheckout:{findFirst:async({where}:any)=>where.tenantId==="a"&&where.id==="checkout"?checkout:null,findFirstOrThrow:async({where}:any)=>{assert.equal(where.tenantId,"a");return checkout;}},
 paymentConnection:{findFirst:async({where}:any)=>where.tenantId==="a"?{id:"connection",locationId:"location"}:null,findFirstOrThrow:async({where}:any)=>{assert.equal(where.tenantId,"a");return{id:"connection",locationId:"location"};}},
 paymentRefund:{findUnique:async({where}:any)=>refunds.find(r=>r.tenantId===where.tenantId_requestId.tenantId&&r.requestId===where.tenantId_requestId.requestId),findFirst:async({where}:any)=>refunds.find(r=>matches(r,where)),aggregate:async({where}:any)=>({_sum:{amountCents:refunds.filter(r=>r.tenantId===where.tenantId&&r.checkoutId===where.checkoutId&&where.status.in.includes(r.status)).reduce((n,r)=>n+r.amountCents,0)}}),create:async({data}:any)=>{const r={id:`refund-${refunds.length}`,...data,status:pendingStatus};refunds.push(r);return r;},update:async({where,data}:any)=>{const r=refunds.find(r=>r.id===where.id);Object.assign(r,data);return r;}},
};
let queue=Promise.resolve();db.$transaction=async(fn:any)=>{const last=queue;let release:any;queue=new Promise(r=>release=r);await last;try{return await fn(db);}finally{release();}};
mock.module("../src/lib/prisma.ts",{namedExports:{prisma:db}});
mock.module("../src/lib/payments/square/client.ts",{namedExports:{accessToken:async()=>"test-token",squareMode:(v:string)=>v,config:()=>({}),publicConnection:async()=>({}),SquareError:class extends Error{},squareRequest:async(mode:string,path:string,token:string,body:any)=>{assert.equal(token,"test-token");calls.push({mode,path,body});if(path.includes("/payments/"))return{payment:{id:"provider-payment",status:"COMPLETED",reference_id:"checkout",location_id:"location",amount_money:{amount:1500,currency:"USD"}}};return{refund:{id:"provider-refund",payment_id:"provider-payment",status:providerStatus,amount_money:{amount:body?.amount_money.amount??500,currency:"USD"}}};}}});
const {prepareRefund,processRefund,refundInput,verifyRefund}=await import("../src/lib/payments/refunds");
const input=(extra:any={})=>({checkoutId:"checkout",requestId:"refund-request-123456",amountCents:500,reason:"Customer cancellation",...extra});
beforeEach(()=>{refunds=[];calls=[];providerStatus="COMPLETED";pendingStatus="PENDING";});
test("refund input rejects fractional cents, zero, oversized reason and missing identity",()=>{for(const extra of [{amountCents:0},{amountCents:1.5},{amountCents:-1},{reason:""},{reason:"x".repeat(193)},{requestId:"short"}])assert.throws(()=>refundInput(input(extra)));});
test("refund reservation is tenant scoped and idempotent without reducing original payment",async()=>{const a=await prepareRefund(actor,input()),b=await prepareRefund(actor,input());assert.equal(a.id,b.id);assert.equal(refunds.length,1);assert.equal(checkout.amountCents,1500);assert.equal(checkout.status,"PAID");await assert.rejects(prepareRefund({...actor,tenantId:"b"},input()));await assert.rejects(prepareRefund(actor,input({amountCents:600})));});
test("concurrent refunds reserve the original amount and prevent over-refunding",async()=>{const outcomes=await Promise.allSettled([prepareRefund(actor,input({amountCents:1000})),prepareRefund(actor,input({amountCents:1000,requestId:"other-refund-request-123"}))]);assert.equal(outcomes.filter(x=>x.status==="fulfilled").length,1);assert.equal(refunds.length,1);});
test("provider submission uses exact original payment and stable key, and completed retries do not refund twice",async()=>{const r=await prepareRefund(actor,input());const done=await processRefund(actor,r.id);assert.equal(done.status,"COMPLETED");assert.equal(calls[1].body.idempotency_key,r.id);assert.equal(calls[1].body.payment_id,"provider-payment");assert.equal(calls[1].body.amount_money.amount,500);await processRefund(actor,r.id);assert.equal(calls.length,2);assert.equal(checkout.amountCents,1500);});
test("pending provider refunds are polled rather than posted again",async()=>{providerStatus="PENDING";const r=await prepareRefund(actor,input());await processRefund(actor,r.id);providerStatus="COMPLETED";await processRefund(actor,r.id);assert.equal(calls.filter(c=>c.body).length,1);assert.equal(calls.at(-1).path,"/v2/refunds/provider-refund");});
test("untrusted refund identities, amounts and currency cannot finalize a local refund",()=>{for(const change of [{payment_id:"other"},{amount_money:{amount:499,currency:"USD"}},{amount_money:{amount:500,currency:"CAD"}},{status:"UNKNOWN"}])assert.throws(()=>verifyRefund({id:"r",payment_id:"p",status:"COMPLETED",amount_money:{amount:500,currency:"USD"},...change},{amountCents:500},"p"));});
