import assert from "node:assert/strict";
import {beforeEach,mock,test} from "node:test";
let party:any,agreement=true,guests=0,links=0,pending=false;
const db:any={$queryRaw:async()=>pending?[{id:"pending"}]:[],tenant:{findUniqueOrThrow:async()=>({bookingSettings:{}})},waiver:{findFirst:async()=>agreement?{id:"waiver"}:null},party:{findUniqueOrThrow:async({where}:any)=>{assert.equal(where.tenantId,"tenant");return {...party};},findFirst:async()=>null,update:async({data,where}:any)=>{assert.equal(where.tenantId,"tenant");Object.assign(party,data);return party;}},partyGuest:{count:async()=>guests},eventTimelineItem:{create:async()=>({})}};db.$transaction=async(fn:any)=>fn(db);
mock.module("../src/lib/prisma.ts",{namedExports:{prisma:db}});
mock.module("../src/lib/auth/staff.ts",{namedExports:{withStaff:(_p:string,h:any)=>h,getStaffContext:()=>({tenantId:"tenant",employeeId:"staff"})}});
mock.module("../src/lib/booking/party-links.ts",{namedExports:{ensurePartyLinks:async()=>{links++;}}});
const {POST}=await import("../src/app/api/events/[eventId]/status/route");
const post=(body:object)=>POST(new Request("https://app.example.invalid/api/test",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}),{params:Promise.resolve({eventId:"party"})});
beforeEach(()=>{party={id:"party",tenantId:"tenant",title:"Party",status:"PENDING",workflowStep:"PENDING",depositAmount:100,depositStatus:"PENDING",balanceDue:200,startTime:new Date("2030-01-01T17:00Z"),endTime:new Date("2030-01-01T19:00Z"),confirmationExpiresAt:new Date("2030-01-01"),confirmedAt:null};agreement=true;guests=0;links=0;pending=false;});
test("the workflow endpoint cannot bypass deposit or rental agreement requirements",async()=>{assert.equal((await post({workflowStep:"CONFIRMED"})).status,409);assert.equal(links,0);party.depositStatus="CARD_COLLECTED";agreement=false;assert.equal((await post({workflowStep:"CONFIRMED"})).status,409);assert.equal(party.status,"PENDING");});
test("ready bookings confirm through the workflow and release links once",async()=>{party.depositStatus="WAIVED";assert.equal((await post({workflowStep:"CONFIRMED"})).status,200);assert.equal(party.status,"CONFIRMED");assert.ok(party.confirmedAt);assert.equal(links,1);assert.equal((await post({workflowStep:"CONFIRMED"})).status,200);assert.equal(links,1);});
test("arbitrary workflow jumps and premature completion are rejected",async()=>{assert.equal((await post({workflowStep:"CLEANUP"})).status,409);assert.equal((await post({complete:true})).status,409);assert.equal(links,0);});
test("unpaid balances or uncertain charges prevent cleanup",async()=>{party.status="IN_PROGRESS";party.workflowStep="PAYMENT";assert.equal((await post({workflowStep:"CLEANUP"})).status,409);party.balanceDue=0;pending=true;assert.equal((await post({workflowStep:"CLEANUP"})).status,409);});
test("all party guests must check out before final completion",async()=>{party.status="CLEANING_UP";party.workflowStep="CLEANUP";party.balanceDue=0;guests=1;assert.equal((await post({complete:true})).status,409);guests=0;assert.equal((await post({complete:true})).status,200);assert.equal(party.status,"COMPLETED");});
