import assert from "node:assert/strict";
import {beforeEach,mock,test} from "node:test";
import {legalForm,FORM_VERSION} from "../src/lib/waivers/forms";
let parties:any[]=[],documents:any[]=[],guests:any[]=[],timelines:any[]=[],coverage:any,failSignature=false,applyDeposit=true,lastFamilyQuery:any;
const tenant:any={id:"tenant",name:"Playhouse",slug:"palmetto-playhouse",timezone:"America/New_York",bookingSettings:{startTimes:["12:00"],daysOfWeek:[0,1,2,3,4,5,6],setupMinutes:30},waiverValidityDays:null};
const parent:any={id:"parent",familyId:"family",tenantId:"tenant",authUserId:"customer",firstName:"Hosting",lastName:"Parent",email:"parent@example.invalid",phone:"8035550100",family:{status:"ACTIVE"}};
const child={id:"child",tenantId:"tenant",familyId:"family",firstName:"Birthday",lastName:"Child",active:true,dateOfBirth:null};
const pkg:any={id:"package",tenantId:"tenant",eventTypeId:"type",name:"Party",price:300,depositAmount:100,durationMinutes:120,active:true};
const staff={tenantId:"tenant",employeeId:"trusted-staff",name:"Venue Cashier"};
const db:any={
 tenant:{findUniqueOrThrow:async()=>tenant},
 parent:{findFirst:async({where}:any)=>where.tenantId===parent.tenantId&&(where.authUserId?where.authUserId===parent.authUserId:where.id===parent.id&&where.familyId===parent.familyId)?parent:null,update:async({where,data}:any)=>{assert.equal(where.tenantId,"tenant");Object.assign(parent,data);return parent;}},
 child:{findFirst:async({where}:any)=>where.id===child.id&&where.tenantId===child.tenantId&&where.familyId===child.familyId?child:null},
 family:{findFirst:async(q:any)=>{lastFamilyQuery=q;if(q.where.tenantId!=="tenant"||q.where.id!=="family")return null;return{id:"family",name:"Hosting Family",parents:[parent],children:[{...child,waivers:coverage?[{id:"coverage"}]:[]}]};},findMany:async(q:any)=>{lastFamilyQuery=q;return[{id:"family",name:"Hosting Family",parents:[parent]}];}},
 waiverChild:{findFirst:async({where}:any)=>{assert.equal(where.waiver.tenantId,"tenant");assert.equal(where.waiver.familyId,"family");assert.equal(where.waiver.kind,"LIABILITY");assert.equal(where.status,"VALID");return coverage;}},
 eventType:{findFirst:async({where}:any)=>where.id==="type"&&where.tenantId==="tenant"?{id:"type"}:null,findMany:async()=>[{id:"type",name:"Party"}]},
 package:{findFirst:async({where}:any)=>where.id==="package"&&where.tenantId==="tenant"?pkg:null,findMany:async()=>[pkg]},
 partyAddOn:{findMany:async()=>[]},partyAddOnItem:{create:async()=>({})},commerceSettings:{findUnique:async()=>({depositRules:{enabled:true,requiredByDefault:true,applyDepositToBalance:applyDeposit}})},
 party:{findFirst:async({where}:any)=>parties.find(p=>p.tenantId===where.tenantId&&(where.bookingRequestId?p.bookingRequestId===where.bookingRequestId:p.id===where.id&&(!where.familyId||p.familyId===where.familyId)&&(!where.primaryParentId||p.primaryParentId===where.primaryParentId))),findUniqueOrThrow:async({where}:any)=>{const p=parties.find(p=>p.id===where.id&&p.tenantId===where.tenantId);if(!p)throw new Error("Not found");return {...p};},findMany:async()=>parties,create:async({data}:any)=>{const p={id:`party-${parties.length}`,payments:[],...data};parties.push(p);return {...p};},update:async({where,data}:any)=>{const p=parties.find(p=>p.id===where.id);Object.assign(p,data);return {...p};},count:async()=>parties.length},
 waiver:{findFirst:async({where}:any)=>documents.find(d=>d.tenantId===where.tenantId&&(where.requestId?d.requestId===where.requestId:d.partyId===where.partyId&&d.kind===where.kind)),create:async({data}:any)=>{if(failSignature)throw new Error("Simulated signature failure");const d={id:`document-${documents.length}`,...data};documents.push(d);return d;}},
 partyGuest:{create:async({data}:any)=>{guests.push(data);return data;}},eventTimelineItem:{create:async({data}:any)=>{timelines.push(data);return data;}},$queryRaw:async()=>[],
};
let queue=Promise.resolve();db.$transaction=async(fn:any)=>{const before=queue;let release:any;queue=new Promise(r=>release=r);await before;const snapshot=[parties,documents,guests,timelines].map(a=>a.slice());try{return await fn(db);}catch(e){[parties,documents,guests,timelines]=snapshot;throw e;}finally{release();}};
mock.module("../src/lib/prisma.ts",{namedExports:{prisma:db}});
mock.module("../src/lib/auth/staff.ts",{namedExports:{withStaff:(_p:string,h:any)=>h,getStaffContext:()=>staff,getStaffTenant:async()=>tenant}});
mock.module("../src/lib/communications/service.ts",{namedExports:{preparePartyMessages:async()=>{}}});
mock.module("../src/lib/booking/party-links.ts",{namedExports:{ensurePartyLinks:async()=>{}}});
const {GET,POST}=await import("../src/app/api/bookings/route");
const {POST:legacyPOST}=await import("../src/app/api/events/route");
const {createBooking}=await import("../src/lib/booking/reservation");
const signature=(extra:any={})=>({version:FORM_VERSION,signerName:"Hosting Parent",signerEmail:"parent@example.invalid",signature:"Hosting Parent",signatureConsent:true,requestId:"rental-signature-123456",acknowledgments:legalForm("RENTAL").clauses.map(c=>c[0]),...extra});
const request=(body?:any,query="")=>new Request(`https://app.example.invalid/api/bookings${query}`,{method:body?"POST":"GET",headers:{"Content-Type":"application/json"},...(body?{body:JSON.stringify(body)}:{})});
async function input(extra:any={}){const r=await GET(request(undefined,`?eventTypeId=type&packageId=package&date=2031-01-11${extra.depositWaived?"&waived=true":""}`));assert.equal(r.status,200);const d=await r.json();return{requestId:"staff-booking-123456",familyId:"family",parentId:"parent",childId:"child",eventTypeId:"type",packageId:"package",eventDate:"2031-01-11",startTime:"12:00",addOnIds:[],quoteToken:d.quoteToken,signing:signature(),...extra};}
beforeEach(()=>{parties=[];documents=[];guests=[];timelines=[];applyDeposit=true;coverage={id:"child-coverage",signedAt:new Date()};failSignature=false;pkg.price=300;parent.email="parent@example.invalid";parent.family.status="ACTIVE";tenant.operationalSettings=null;});
test("staff booking requires the hosting parent's current rental signature before any reservation exists",async()=>{const b=await input();for(const signing of [undefined,signature({signatureConsent:false}),signature({acknowledgments:[]}),signature({version:"stale"}),signature({signerName:"Cashier",signature:"Cashier"}),signature({signerEmail:"other@example.invalid"})])assert.ok((await POST(request({...b,signing}))).status>=400);assert.equal(parties.length,0);assert.equal(documents.length,0);});
test("staff booking saves the guardian agreement and booking atomically with staff witness and child linkage",async()=>{const b=await input({staffId:"spoofed-staff",total:1,depositStatus:"PAID"});const r=await POST(request(b));assert.equal(r.status,200);const saved=(await r.json()).booking;assert.equal(saved.depositDue,100);assert.equal(saved.balanceDue,300);assert.equal(saved.status,"PENDING");assert.equal(parties[0].primaryParentId,"parent");assert.equal(parties[0].familyId,"family");assert.equal(parties[0].pricingSnapshot.source,"STAFF_BOOKING");assert.equal(documents[0].signedById,"parent");assert.equal(documents[0].partyId,saved.id);assert.equal(documents[0].kind,"RENTAL");assert.equal(documents[0].acknowledgments.identityMethod,"IN_PERSON_GUARDIAN");assert.equal(documents[0].acknowledgments.witness.staffId,"trusted-staff");assert.equal(guests[0].waiverChildId,"child-coverage");assert.equal(JSON.parse(documents[0].waiverText).event.total,300);assert.equal(parties[0].setupStartsAt.toISOString(),"2031-01-11T16:30:00.000Z");});
test("another family, guardian, child or missing liability waiver cannot be substituted",async()=>{const b=await input();for(const extra of [{familyId:"foreign"},{parentId:"foreign"},{childId:"foreign"}])assert.equal((await POST(request({...b,...extra}))).status,403);coverage=null;assert.equal((await POST(request(b))).status,409);assert.equal(parties.length,0);});
test("retrying through either staff creation URL saves only one booking and signature",async()=>{const b=await input();const [a,c]=await Promise.all([POST(request(b)),legacyPOST(request(b))]);assert.equal(a.status,200);assert.equal(c.status,200);assert.equal(parties.length,1);assert.equal(documents.length,1);assert.equal((await POST(request({...b,notes:"changed"}))).status,409);});
test("concurrent different requests cannot reserve the same slot twice",async()=>{const b=await input();const responses=await Promise.all([POST(request(b)),POST(request({...b,requestId:"different-booking-123456",signing:signature({requestId:"different-signature-123456"})}))]);assert.deepEqual(responses.map(r=>r.status).sort(),[200,409]);assert.equal(documents.length,1);});
test("signature persistence failure rolls back the booking and a retry can reserve it",async()=>{const b=await input();failSignature=true;await assert.rejects(POST(request(b)),/signature failure/);assert.equal(parties.length,0);assert.equal(documents.length,0);failSignature=false;assert.equal((await POST(request(b))).status,200);});
test("a changed price or published agreement requires review before booking",async()=>{const b=await input();pkg.price=350;assert.equal((await POST(request(b))).status,409);pkg.price=300;tenant.operationalSettings={forms:{RENTAL:{...legalForm("RENTAL"),version:"published-new-version"}}};assert.equal((await POST(request(b))).status,409);assert.equal(parties.length,0);});
test("staff can waive a deposit with a reason but the parent's agreement is still required",async()=>{const b=await input({depositWaived:true,depositWaiverReason:"Approved by venue owner"});assert.equal((await POST(request({...b,signing:undefined}))).status,400);assert.equal((await POST(request({...b,depositWaiverReason:""}))).status,400);const r=await POST(request(b));assert.equal(r.status,200);const saved=(await r.json()).booking;assert.equal(saved.status,"CONFIRMED");assert.equal(saved.depositDue,0);assert.equal(parties[0].depositStatus,"WAIVED");assert.equal(JSON.parse(documents[0].waiverText).event.depositWaiverReason,"Approved by venue owner");});
test("parent requests cannot use staff deposit waiver authority and staff cannot target another business",async()=>{const b=await input({depositWaived:true,depositWaiverReason:"Forged authority"});await assert.rejects(createBooking(db,"tenant",{kind:"parent",user:{id:"customer",email:parent.email}},b),/Only venue staff/);await assert.rejects(createBooking(db,"tenant",{kind:"staff",staff:{...staff,tenantId:"other-business"}},b),/another business/);assert.equal(parties.length,0);});
test("booking refresh reports the remaining deposit after partial payments and enforces tenant ownership",async()=>{const b=await input();const r=await POST(request(b));const saved=(await r.json()).booking;parties[0].payments=[{amount:40}];parties[0].balanceDue=260;const refreshed=await GET(request(undefined,`?partyId=${saved.id}`));const d=await refreshed.json();assert.equal(d.booking.depositDue,60);assert.equal(d.booking.balanceDue,260);assert.equal((await GET(request(undefined,"?partyId=foreign-party"))).status,404);});
test("family search and selection are tenant scoped and omit unrelated records",async()=>{assert.equal((await GET(request(undefined,"?familyId=foreign"))).status,404);assert.equal(lastFamilyQuery.where.tenantId,"tenant");const r=await GET(request(undefined,"?familyId=family"));assert.equal((await r.json()).family.children[0].id,"child");await GET(request(undefined,"?q=Parent"));assert.equal(lastFamilyQuery.where.tenantId,"tenant");assert.equal(lastFamilyQuery.take,20);});
test("a disabled party module prevents new staff bookings",async()=>{const b=await input();tenant.operationalSettings={modules:{parties:false}};assert.equal((await POST(request(b))).status,409);assert.equal(parties.length,0);});

test("refreshed deposit totals honor whether deposits reduce the booking balance",async()=>{const r=await POST(request(await input()));const id=(await r.json()).booking.id;parties[0].payments=[{amount:40}];parties[0].balanceDue=50;let summary=await(await GET(request(undefined,`?partyId=${id}`))).json();assert.equal(summary.booking.depositDue,50);applyDeposit=false;summary=await(await GET(request(undefined,`?partyId=${id}`))).json();assert.equal(summary.booking.depositDue,60);});
