import assert from "node:assert/strict";
import {beforeEach,mock,test} from "node:test";
let scope:any,party:any,agreement:boolean,processed:number,prepared:number,intent:any;
const parent={id:"parent-1",familyId:"family-1",firstName:"Test",lastName:"Parent"},tenant={id:"tenant-1"};
const prisma={party:{findFirst:async({where}:any)=>{scope=where;return party&&party.id===where.id&&party.familyId===where.familyId&&party.primaryParentId===where.primaryParentId?party:null;}},waiver:{findFirst:async()=>agreement?{id:"agreement-1"}:null},providerCheckout:{findFirst:async({where}:any)=>intent&&where.id===intent.id&&where.tenantId===tenant.id?intent:null}};
mock.module("../src/lib/prisma.ts",{namedExports:{prisma}});
mock.module("../src/lib/parent/access.ts",{namedExports:{withParent:(handler:any)=>handler,getParentContext:()=>({tenant,parent})}});
mock.module("../src/lib/payments/square/client.ts",{namedExports:{publicConnection:async()=>({mode:"sandbox",ready:false,applicationId:"",locationId:null})}});
mock.module("../src/lib/payments/square/checkout.ts",{namedExports:{prepareCheckout:async()=>{prepared++;return{id:"intent-1"};},processCheckout:async()=>{processed++;return{id:"intent-1",status:"PAID"};},publicCheckout:(i:any)=>i}});
const {POST}=await import("../src/app/api/parent/[slug]/payments/route");
const submit=(extra:any={})=>POST(new Request("https://example.invalid/api/parent/venue/payments",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({kind:"party",partyId:"party-1",purpose:"DEPOSIT",amountCents:1000,requestId:"request-1234567890",sourceToken:"secure-token",...extra})}));
beforeEach(()=>{party={id:"party-1",familyId:"family-1",primaryParentId:"parent-1"};agreement=true;processed=0;prepared=0;intent=null;scope=null;});
test("parent deposit authorization includes tenant, family and hosting parent",async()=>{assert.equal((await submit()).status,200);assert.deepEqual(scope,{id:"party-1",tenantId:"tenant-1",familyId:"family-1",primaryParentId:"parent-1"});assert.equal(prepared,1);assert.equal(processed,1);});
test("a party in another family cannot be charged",async()=>{party.familyId="family-other";assert.equal((await submit()).status,404);assert.equal(processed,0);});
test("another parent in the same family cannot pay a host-owned booking",async()=>{party.primaryParentId="other-parent";assert.equal((await submit()).status,404);assert.equal(processed,0);});
test("unsigned rental agreement blocks card processing",async()=>{agreement=false;assert.equal((await submit()).status,409);assert.equal(prepared,0);assert.equal(processed,0);});
test("parent route cannot submit counter sales or balance payments",async()=>{assert.equal((await submit({purpose:"BALANCE"})).status,403);assert.equal((await submit({kind:"counter"})).status,403);assert.equal(processed,0);});
test("missing checkout ID cannot accidentally resume the first pending payment",async()=>{assert.equal((await submit({action:"status",id:undefined})).status,400);assert.equal(processed,0);});
test("payment recovery rechecks booking ownership",async()=>{intent={id:"intent-1",payload:{partyId:"party-other"}};assert.equal((await submit({action:"status",id:"intent-1"})).status,404);assert.equal(processed,0);});
