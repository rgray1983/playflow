DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# One-time first owner setup. Use a random 32+ character secret.
PLAYFLOW_SETUP_TOKEN=
PLAYFLOW_SETUP_TENANT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional platform booking email. Business accounts do not configure these keys.
RESEND_API_KEY=
PLAYFLOW_EMAIL_FROM=
# Absolute HTTPS URL used in customer email links.
PLAYFLOW_APP_URL=
# Authenticate the scheduled GET /api/jobs/communications trigger.
CRON_SECRET=

# Booking email defaults to test mode; Vercel previews always enforce test mode.
PLAYFLOW_EMAIL_DELIVERY_MODE=test
# Exact comma-separated inboxes. Empty or malformed configuration blocks every recipient.
PLAYFLOW_EMAIL_TEST_RECIPIENTS=
