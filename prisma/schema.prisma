generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  PAUSED
}

enum MembershipBillingInterval {
  NONE
  MONTHLY
  YEARLY
}

enum WaiverStatus {
  VALID
  MISSING
  EXPIRED
  REVOKED
}

enum VisitStatus {
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PartyStatus {
  PENDING
  CONFIRMED
  READY
  IN_PROGRESS
  CLEANING_UP
  COMPLETED
  CANCELLED
}

enum PartyGuestStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TimeClockStatus {
  CLOCKED_IN
  CLOCKED_OUT
}

enum SearchEntityType {
  FAMILY
  PARENT
  CHILD
  PARTY
  MEMBERSHIP
  WAIVER
  EMPLOYEE
}

enum EventDepositStatus {
  PENDING
  CASH_COLLECTED
  CARD_COLLECTED
  OTHER_COLLECTED
  WAIVED
}

enum EventPaymentMethod {
  CASH
  CARD
  OTHER
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerAuthUserId String? @unique
  timezone  String   @default("America/New_York")
  familyChanges FamilyChange[]
  bookingSettings Json?
  operationalSettings Json?
  waiverValidityDays Int?
  phone     String?
  email     String?
  website   String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  logoUrl       String?
  iconLogoUrl   String?
  primaryColor  String?
  accentColor   String?
  tertiaryColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentConnections PaymentConnection[]
  providerCheckouts ProviderCheckout[]
  bookingMessages BookingMessage[]
  paymentRefunds PaymentRefund[]
  counterProducts CounterProduct[]
  counterSales CounterSale[]
  counterPayments CounterPayment[]
  families          Family[]
  parents           Parent[]
  children          Child[]
  visits            Visit[]
  membershipPlans   MembershipPlan[]
  memberships       Membership[]
  membershipPayments MembershipPayment[]
  waivers           Waiver[]
  parties           Party[]
  partyGuests       PartyGuest[]
  partyAddOns       PartyAddOn[]
  partyAddOnItems   PartyAddOnItem[]
  admissionTypes    AdmissionType[]
  eventTypes        EventType[]
  packages          Package[]
  staffRoles        StaffRole[]
  employees         Employee[]
  employeeTimeClocks EmployeeTimeClock[]
  eventTimelineItems EventTimelineItem[]
  eventPayments EventPayment[]
  commerceSettings CommerceSettings?
}

model CommerceSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  paymentMethods Json
  depositRules   Json
  taxRules       Json
  feeRules       Json
  tipRules       Json
  discountRules  Json
  refundRules    Json
  receiptRules   Json
  checkoutRules  Json
  processorRules Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Family {
  changes FamilyChange[]
  counterSales CounterSale[]
  intakeRequestId String?
  intakeRequestHash String?
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  status    AccountStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parents     Parent[]
  children    Child[]
  visits      Visit[]
  memberships Membership[]
  waivers     Waiver[]
  parties     Party[]
  membershipPayments MembershipPayment[]

  @@index([tenantId])
  @@index([name])
  @@unique([tenantId, intakeRequestId])
}

model Parent {
  id        String   @id @default(cuid())
  tenantId  String
  authUserId String?
  legacyWixId String?
  legacyWixMemberId String?
  familyClaimHash String?
  familyClaimExpiresAt DateTime?
  emergencyContact String?
  emergencyPhone String?
  relationshipToChild String?
  familyId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  waivers Waiver[]
  parties Party[]
  guardianVisits Visit[] @relation("VisitGuardian")

  @@unique([tenantId, authUserId])
  @@unique([tenantId, legacyWixId])
  @@unique([tenantId, legacyWixMemberId])
  @@unique([tenantId, familyClaimHash])
  @@index([tenantId])
  @@index([familyId])
  @@index([lastName])
  @@index([email])
  @@index([phone])
}

model Child {
  intakeRequestId String?
  id           String   @id @default(cuid())
  tenantId     String
  legacyWixId String?
  familyId     String
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  allergies    String?
  medicalNotes String?
  photoUrl     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  visits      Visit[]
  memberships Membership[]
  waivers     WaiverChild[]
  partyGuests PartyGuest[]

  @@unique([tenantId, legacyWixId])
  @@unique([tenantId, intakeRequestId])
  @@index([tenantId])
  @@index([familyId])
  @@index([firstName])
  @@index([lastName])
}

model Visit {
  counterSaleId String?
  counterSale CounterSale? @relation(fields:[counterSaleId], references:[id], onDelete:Restrict)
  requestId String?
  requestHash String?
  guardianParentId String?
  membershipId String?
  waiverChildId String?
  admissionSnapshot Json?
  checkInStaffId String?
  checkInStaffName String?
  checkOutStaffId String?
  checkOutStaffName String?
  guardianParent Parent? @relation("VisitGuardian", fields:[guardianParentId], references:[id], onDelete:Restrict)
  membership Membership? @relation(fields:[membershipId], references:[id], onDelete:Restrict)
  waiverChild WaiverChild? @relation(fields:[waiverChildId], references:[id], onDelete:Restrict)
  id           String      @id @default(cuid())
  tenantId     String
  familyId     String
  childId      String
  checkedInAt  DateTime    @default(now())
  checkedOutAt DateTime?
  status       VisitStatus @default(CHECKED_IN)
  visitType    String      @default("Open Play")
  admissionTypeId String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  admissionType AdmissionType? @relation(fields: [admissionTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([familyId])
  @@index([childId])
  @@index([checkedInAt])
  @@index([status])
  @@index([admissionTypeId])
  @@index([membershipId])
  @@index([tenantId, requestId])
  @@unique([tenantId, childId, requestId])
  @@index([counterSaleId])
  // A migration adds a partial unique index for one active visit per tenant/child.
}

model AdmissionType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  color       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@index([tenantId])
  @@index([active])
}

model EventType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parties Party[]
  packages Package[]

  @@index([tenantId])
  @@index([active])
}

model Package {
  id              String   @id @default(cuid())
  tenantId        String
  eventTypeId     String?
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  depositAmount   Decimal? @db.Decimal(10, 2)
  guestLimit      Int?
  durationMinutes Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType EventType?  @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  parties   Party[]

  @@index([tenantId])
  @@index([eventTypeId])
  @@index([active])
}

model MembershipPlan {
  id              String                     @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  price           Decimal                    @db.Decimal(10, 2)
  billingInterval MembershipBillingInterval  @default(NONE)
  durationDays    Int?
  visitLimit      Int?
  autoRenewDefault Boolean                   @default(false)
  active          Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([tenantId])
  @@index([active])
}

model Membership {
  termsSnapshot Json?
  counterSale CounterSale?
  id                   String           @id @default(cuid())
  tenantId             String
  familyId             String
  childId              String?
  membershipPlanId     String?
  name                 String
  status               MembershipStatus @default(ACTIVE)
  startsAt             DateTime
  endsAt               DateTime?
  autoRenew            Boolean          @default(false)
  nextBillingAt        DateTime?
  cancelledAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child          Child?          @relation(fields: [childId], references: [id], onDelete: SetNull)
  membershipPlan MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  payments       MembershipPayment[]
  visits Visit[]

  @@index([tenantId])
  @@index([familyId])
  @@index([childId])
  @@index([membershipPlanId])
  @@index([status])
  @@index([endsAt])
  @@index([nextBillingAt])
}

model MembershipPayment {
  id                  String        @id @default(cuid())
  tenantId            String
  familyId            String
  membershipId        String
  amount              Decimal       @db.Decimal(10, 2)
  status              PaymentStatus @default(PENDING)
  paidAt              DateTime?
  dueAt               DateTime?
  processor           String?
  processorPaymentId  String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([familyId])
  @@index([membershipId])
  @@index([status])
  @@index([dueAt])
}

model Waiver {
  id         String       @id @default(cuid())
  tenantId   String
  kind String @default("LIABILITY")
  version String?
  requestId String?
  requestHash String?
  signerName String?
  signerEmail String?
  acknowledgments Json?
  photoConsent Boolean @default(false)
  partyId String?
  familyId   String
  signedById String?
  status     WaiverStatus @default(VALID)
  signedAt   DateTime?
  expiresAt  DateTime?
  signature  String?
  pdfUrl     String?
  waiverText String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family   Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  signedBy Parent?       @relation(fields: [signedById], references: [id], onDelete: SetNull)
  children WaiverChild[]
  party Party? @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([tenantId, requestId])
  @@index([partyId])
  @@index([tenantId])
  @@index([familyId])
  @@index([signedById])
  @@index([status])
  @@index([expiresAt])
}

model WaiverChild {
  id       String @id @default(cuid())
  waiverId String
  signedAt DateTime?
  status WaiverStatus @default(VALID)
  childNameSnapshot String?
  dateOfBirthSnapshot DateTime?
  partyGuests PartyGuest[]
  visits Visit[]
  childId  String

  waiver Waiver @relation(fields: [waiverId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([waiverId, childId])
  @@index([childId])
}

model Party {
  bookingMessages BookingMessage[]
  id             String      @id @default(cuid())
  tenantId       String
  familyId       String?
  bookingRequestId String?
  pricingSnapshot Json?
  primaryParentId String?
  eventTypeId    String?
  packageId      String?
  eventNumber    String?     @unique
  inviteToken    String?     @unique
  hostToken      String?     @unique
  inviteUrl      String?
  title          String
  eventDate      DateTime
  startTime      DateTime
  setupStartsAt DateTime?
  endTime        DateTime
  status         PartyStatus @default(PENDING)
  workflowStep          String?
  confirmationToken     String?   @unique
  confirmationUrl       String?
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?
  depositCapturedAt     DateTime?
  packageName    String?
  guestCount     Int?
  guestOfHonor   String?
  room           String?
  depositAmount  Decimal?    @db.Decimal(10, 2)
  depositStatus  EventDepositStatus @default(PENDING)
  depositMethod  EventPaymentMethod?
  balanceDue     Decimal?    @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family        Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  primaryParent Parent?        @relation(fields: [primaryParentId], references: [id], onDelete: SetNull)
  eventType     EventType?     @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  signedForms   Waiver[]
  guests        PartyGuest[]
  addOnItems    PartyAddOnItem[]
  timelineItems EventTimelineItem[]
  payments      EventPayment[]

  @@index([tenantId])
  @@index([familyId])
  @@index([primaryParentId])
  @@index([eventTypeId])
  @@index([packageId])
  @@index([eventDate])
  @@index([eventNumber])
  @@index([inviteToken])
  @@index([status])
  @@index([workflowStep])
  @@index([confirmationExpiresAt])
  @@unique([tenantId, bookingRequestId])
}

model PartyGuest {
  id          String           @id @default(cuid())
  tenantId    String
  partyId     String
  waiverChildId String?
  waiverChild WaiverChild? @relation(fields: [waiverChildId], references: [id], onDelete: Restrict)
  childId     String?
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  parentName  String?
  status      PartyGuestStatus @default(EXPECTED)
  rsvpStatus  String           @default("ATTENDING")
  waiverStatus String          @default("NEEDED")
  waiverSignedAt DateTime?
  declinedAt DateTime?
  declineReason String?
  checkedInAt DateTime?
  checkedOutAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party  Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  child  Child? @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([partyId])
  @@index([childId])
  @@index([status])
  @@index([rsvpStatus])
  @@index([waiverStatus])
}

model PartyAddOn {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  durationMinutes Int @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PartyAddOnItem[]

  @@index([tenantId])
  @@index([active])
}

model PartyAddOnItem {
  id           String   @id @default(cuid())
  tenantId     String
  partyId      String
  partyAddOnId String
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party      Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyAddOn PartyAddOn @relation(fields: [partyAddOnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([partyId])
  @@index([partyAddOnId])
}

model EventPayment {
  providerMode String?
  id            String             @id @default(cuid())
  tenantId      String
  partyId       String
  requestId     String?
  requestFingerprint String?
  purpose       String @default("BALANCE")
  staffName     String?
  staffEmployeeId String?
  amount        Decimal            @db.Decimal(10, 2)
  method        EventPaymentMethod
  status        PaymentStatus      @default(PAID)
  collectedAt   DateTime           @default(now())
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party  Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, partyId, requestId])
  @@index([tenantId])
  @@index([partyId])
  @@index([method])
  @@index([status])
  @@index([collectedAt])
}

model EventTimelineItem {
  id        String   @id @default(cuid())
  tenantId  String
  partyId   String
  title     String
  body      String?
  icon      String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party  Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([partyId])
  @@index([createdAt])
}

model StaffRole {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@index([tenantId])
  @@index([active])
}

model Employee {
  id        String         @id @default(cuid())
  tenantId  String
  authUserId String? @unique
  accessRole String @default("FRONT_DESK")
  accessApproved Boolean @default(false)
  staffRoleId String?
  firstName String
  lastName  String
  email     String?
  phone     String?
  role      String?
  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffRole  StaffRole?          @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  timeClocks EmployeeTimeClock[]

  @@index([tenantId])
  @@index([staffRoleId])
  @@index([lastName])
  @@index([email])
  @@index([status])
}

model EmployeeTimeClock {
  id           String          @id @default(cuid())
  tenantId     String
  employeeId   String
  clockedInAt  DateTime        @default(now())
  clockedOutAt DateTime?
  status       TimeClockStatus @default(CLOCKED_IN)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([clockedInAt])
  @@index([status])
}

// Ledger amounts are integer USD cents. Snapshots preserve the reviewed transaction.
model CounterSale {
  id String @id @default(cuid())
  tenantId String
  familyId String
  requestId String
  requestHash String
  kind String
  status String @default("OPEN")
  subtotalCents Int
  taxCents Int
  feeCents Int
  totalCents Int
  quoteSnapshot Json
  businessSnapshot Json
  membershipId String? @unique
  staffId String
  staffName String
  voidedAt DateTime?
  voidedBy String?
  voidReason String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  family Family @relation(fields:[familyId],references:[id],onDelete:Restrict)
  membership Membership? @relation(fields:[membershipId],references:[id],onDelete:Restrict)
  visits Visit[]
  payments CounterPayment[]
  @@unique([tenantId, requestId])
  @@index([tenantId, familyId, createdAt])
}
model CounterPayment {
  providerMode String?
  id String @id @default(cuid())
  tenantId String
  saleId String
  requestId String
  requestHash String
  amountCents Int
  method String
  methodLabel String
  notes String?
  staffId String
  staffName String
  collectedAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  sale CounterSale @relation(fields:[saleId],references:[id],onDelete:Restrict)
  @@unique([tenantId, requestId])
  @@index([saleId, collectedAt])
}

model CounterProduct {
  id String @id @default(cuid())
  tenantId String
  name String
  category String
  priceCents Int
  active Boolean @default(true)
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  @@index([tenantId, active, category])
}

model PaymentConnection {
  checkouts ProviderCheckout[]
  id String @id @default(cuid())
  tenantId String
  mode String
  merchantId String?
  locationId String?
  locationLabel String?
  accessToken String?
  refreshToken String?
  expiresAt DateTime?
  stateHash String? @unique
  stateExpiresAt DateTime?
  stateUserId String?
  connectedBy String?
  checkedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  @@unique([tenantId,mode])
}

model ProviderCheckout {
  channel String @default("CARD")
  readerState String?
  readerOrderId String?
  refunds PaymentRefund[]
  id String @id @default(cuid())
  tenantId String
  connectionId String
  connection PaymentConnection @relation(fields:[connectionId],references:[id],onDelete:Restrict)
  mode String
  requestId String
  requestHash String
  status String @default("PENDING")
  amountCents Int
  targetKeys String[]
  payload Json
  actor Json
  sourceToken String?
  providerPaymentId String? @unique
  receiptUrl String?
  failureCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  @@unique([tenantId,requestId])
  @@index([tenantId,status])
}

model BookingMessage {
